# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.sabpaisa.com
NEXT_PUBLIC_ADMIN_API_URL=https://adminapi.sabpaisa.in
NEXT_PUBLIC_REPORT_API_URL=https://reportapi.sabpaisa.in
NEXT_PUBLIC_REPORT_BASE_URL=https://reportapi.sabpaisa.in
NEXT_PUBLIC_TXN_HISTORY_DBS_URL=https://reportapi.sabpaisa.in
NEXT_PUBLIC_COB_API_URL=https://cobawsapi.sabpaisa.in

# Environment
NEXT_PUBLIC_ENV=development

# Encryption
NEXT_PUBLIC_ENCRYPTION_KEY=your-encryption-key-here

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true
